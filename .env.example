PORT=5000
MONGO_URI="mongodb://127.0.0.1:27017/herbs_wellness"

# Access Token — short-lived (1 day)
JWT_ACCESS_SECRET=your_access_token_secret_change_this
ACCESS_TOKEN_EXPIRES_IN=1d

# Refresh Token — long-lived (15 days), use a DIFFERENT secret
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_too
REFRESH_TOKEN_EXPIRES_IN=15d

CLIENT_URL=http://localhost:3000
NODE_ENV=development

# URL used by the Next.js server to reach the Express backend (rewrites proxy)
BACKEND_URL=http://localhost:5000

# Production frontend URL(s), comma-separated when more than one is needed.
# Example: https://herbs-wellness.vercel.app,https://herbs-wellness.netlify.app
# CLIENT_URL=https://your-frontend-domain.example
